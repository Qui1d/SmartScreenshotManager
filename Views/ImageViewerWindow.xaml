<Window
    x:Class="SmartScreenshotManager.Views.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screenshot">

    <Grid
        x:Name="RootGrid"
        Background="Black">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="Escape"
                Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Image
            x:Name="ViewerImage"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Stretch="Uniform" />

        <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="20"
            Width="44"
            Height="44"
            Padding="0"
            Click="CloseButton_Click">

            <FontIcon
                Glyph="&#xE711;"
                FontSize="14" />

        </Button>

        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"
            Padding="14,8"
            CornerRadius="8"
            Background="#CC202020">

            <TextBlock
                x:Name="FileNameText"
                Foreground="White"
                FontSize="13" />

        </Border>

    </Grid>

</Window>