<Window
    x:Class="SmartScreenshotManager.Views.SnippingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmartScreenshotManager.Views"
    Title="Snipping">

    <local:CaptureGrid
        x:Name="RootGrid"
        Background="Black"
        PointerPressed="RootGrid_PointerPressed"
        PointerMoved="RootGrid_PointerMoved"
        PointerReleased="RootGrid_PointerReleased">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="Escape"
                Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Frozen desktop screenshot -->
        <Image
            x:Name="ScreenImage"
            Stretch="Fill"
            IsHitTestVisible="False" />

        <!-- Initial dark overlay -->
        <Rectangle
            x:Name="FullDim"
            Fill="#88000000"
            IsHitTestVisible="False" />

        <!-- Selection overlay -->
        <Canvas
            x:Name="OverlayCanvas"
            Background="Transparent"
            IsHitTestVisible="False">

            <Rectangle
                x:Name="TopDim"
                Fill="#88000000" />

            <Rectangle
                x:Name="BottomDim"
                Fill="#88000000" />

            <Rectangle
                x:Name="LeftDim"
                Fill="#88000000" />

            <Rectangle
                x:Name="RightDim"
                Fill="#88000000" />

            <Rectangle
                x:Name="SelectionRectangle"
                Stroke="White"
                StrokeThickness="2"
                Fill="#10FFFFFF"
                Visibility="Collapsed" />

            <Border x:Name="SelectionSizeBadge" Visibility="Collapsed"
                Background="#EE202020" CornerRadius="6" Padding="10,6">
                <TextBlock x:Name="SelectionSizeText" Foreground="White" FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <!-- Hint -->
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0"
            Padding="18,10"
            CornerRadius="8"
            Background="#DD202020"
            >

            <StackPanel
                Orientation="Horizontal"
                Spacing="12">

                <TextBlock
                    Text="Select an area to capture"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontWeight="SemiBold" />

                <Button x:Name="CancelCaptureButton" Content="Esc to cancel"
                    VerticalAlignment="Center"
                    Click="CancelCaptureButton_Click" Loaded="CancelCaptureButton_Loaded" />

            </StackPanel>

        </Border>

    </local:CaptureGrid>

</Window>