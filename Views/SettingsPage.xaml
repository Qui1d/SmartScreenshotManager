<UserControl
    x:Class="SmartScreenshotManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootControl"
    IsTabStop="True"
    KeyDown="RootControl_KeyDown"
    KeyUp="RootControl_KeyUp">

    <ScrollViewer>

        <StackPanel
            Spacing="24"
            MaxWidth="850"
            HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Settings"
                    FontSize="30"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Configure Smart Screenshot Manager"
                    Opacity="0.65" />

            </StackPanel>

            <!-- Screenshot folder -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Screenshot folder"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Screenshots displayed in the application and new snips will be stored in this folder."
                        TextWrapping="Wrap"
                        Opacity="0.65" />

                    <Border
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">

                        <TextBlock
                            x:Name="ScreenshotFolderText"
                            Text="No folder selected"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />

                    </Border>

                    <Button
                        Content="Change folder"
                        HorizontalAlignment="Left"
                        Click="ChangeFolderButton_Click" />

                </StackPanel>

            </Border>

            <!-- Hotkey -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="18">

                    <TextBlock
                        Text="Screenshot hotkey"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="This shortcut will be used to start a new snip."
                        TextWrapping="Wrap"
                        Opacity="0.65" />

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Current shortcut"
                            FontWeight="SemiBold" />

                        <Border
                            Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">

                            <StackPanel Spacing="4">

                                <TextBlock
                                    x:Name="CurrentHotkeyText"
                                    Text="Ctrl + Shift + S"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    x:Name="HotkeyStatusText"
                                    Text="Press Change hotkey to record a new shortcut."
                                    FontSize="12"
                                    Opacity="0.6" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">

                        <Button
                            x:Name="ChangeHotkeyButton"
                            Content="Change hotkey"
                            Click="ChangeHotkeyButton_Click" />

                        <Button
                            x:Name="ResetHotkeyButton"
                            Content="Reset to default"
                            Click="ResetHotkeyButton_Click" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>