<UserControl
    x:Class="SmartScreenshotManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootControl"
    IsTabStop="True"
    KeyDown="RootControl_KeyDown"
    KeyUp="RootControl_KeyUp">

    <ScrollViewer>

        <StackPanel
            Spacing="24"
            MaxWidth="850"
            HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Settings"
                    FontSize="30"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="Configure Smart Screenshot Manager"
                    Opacity="0.65" />

            </StackPanel>

            <!-- Screenshot folder -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Screenshot folder"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Screenshots displayed in the application and new snips will be stored in this folder."
                        TextWrapping="Wrap"
                        Opacity="0.65" />

                    <Border
                        Padding="12"
                        CornerRadius="8"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">

                        <TextBlock
                            x:Name="ScreenshotFolderText"
                            Text="No folder selected"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />

                    </Border>

                    <Button
                        Content="Change folder"
                        HorizontalAlignment="Left"
                        Click="ChangeFolderButton_Click" />

                </StackPanel>

            </Border>

            <!-- Hotkey -->
            <Border
                Padding="20"
                CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">

                <StackPanel Spacing="18">

                    <TextBlock
                        Text="Screenshot hotkey"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="This shortcut will be used to start a new snip."
                        TextWrapping="Wrap"
                        Opacity="0.65" />

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="Current shortcut"
                            FontWeight="SemiBold" />

                        <Border
                            Padding="16"
                            CornerRadius="8"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">

                            <StackPanel Spacing="4">

                                <TextBlock
                                    x:Name="CurrentHotkeyText"
                                    Text="Ctrl + Shift + S"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    x:Name="HotkeyStatusText"
                                    Text="Press Change hotkey to record a new shortcut."
                                    FontSize="12"
                                    Opacity="0.6" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">

                        <Button
                            x:Name="ChangeHotkeyButton"
                            Content="Change hotkey"
                            Click="ChangeHotkeyButton_Click" />

                        <Button
                            x:Name="ResetHotkeyButton"
                            Content="Reset to default"
                            Click="ResetHotkeyButton_Click" />

                    </StackPanel>

                </StackPanel>

            </Border>

            <Border Padding="20" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="AI analysis" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="AI sends a resized screenshot and its recognized text to OpenAI to create a description, category and tags. API usage is billed separately."
                        TextWrapping="Wrap" Opacity="0.7" />
                    <ToggleSwitch x:Name="AiEnabledToggle" Header="Enable AI analysis" />
                    <ToggleSwitch x:Name="AiAutomaticToggle" Header="Automatically analyze new screenshots" />
                    <TextBlock Text="Automatic analysis applies only to screenshots added while this option is enabled. Existing screenshots can be analyzed from Details. Changes take effect after Save."
                        TextWrapping="Wrap" Opacity="0.7" />
                    <PasswordBox x:Name="AiApiKeyBox" Header="OpenAI API key"
                        PlaceholderText="Enter a key; leave blank to keep the saved key" />
                    <TextBlock x:Name="AiKeyStatusText" Text="No API key saved." TextWrapping="Wrap" Opacity="0.7" />
                    <TextBox x:Name="AiModelBox" Header="Model" Text="gpt-4.1-mini-2025-04-14" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Save AI settings" Click="SaveAiSettingsButton_Click" />
                        <Button Content="Remove API key" Click="RemoveAiKeyButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="AiSettingsStatusText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>