<UserControl x:Class="SmartScreenshotManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootControl" IsTabStop="True" KeyDown="RootControl_KeyDown" KeyUp="RootControl_KeyUp">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Expander Header="General" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="Screenshot folder" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScreenshotFolderText" Text="No folder selected" TextWrapping="Wrap" Opacity="0.7" />
                    <Button Content="Change folder" Click="ChangeFolderButton_Click" />
                    <ToggleSwitch x:Name="CloseToTrayToggle" Header="Close to system tray" Toggled="CloseToTrayToggle_Toggled" />
                    <TextBlock Text="Keep hotkeys and processing active. Use Exit in the tray menu to quit." TextWrapping="Wrap" Opacity="0.65" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Start with Windows" Toggled="StartupToggle_Toggled" />
                    <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" Opacity="0.65" />
                </StackPanel>
            </Expander>
            <Expander Header="Capture" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="AutoCopyToggle" Header="Copy new screenshots to clipboard" Toggled="AutoCopyToggle_Toggled" />
                    <TextBlock Text="Screenshot hotkey" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentHotkeyText" FontSize="18" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChangeHotkeyButton" Content="Change hotkey" Click="ChangeHotkeyButton_Click" />
                        <Button x:Name="ResetHotkeyButton" Content="Reset" Click="ResetHotkeyButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" Opacity="0.65" />
                    <TextBlock x:Name="CaptureSettingsStatusText" TextWrapping="Wrap" Opacity="0.65" />
                </StackPanel>
            </Expander>
            <Expander Header="AI analysis" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Text="Uses your OpenAI API balance. Changes apply after Save." TextWrapping="Wrap" Opacity="0.7" />
                    <ToggleSwitch x:Name="AiEnabledToggle" Header="Enable AI analysis" />
                    <ToggleSwitch x:Name="AiAutomaticToggle" Header="Analyze new screenshots automatically"
                        ToolTipService.ToolTip="Only new screenshots are analyzed automatically. Existing ones can be analyzed from Details." />
                    <PasswordBox x:Name="AiApiKeyBox" Header="API key" PlaceholderText="Leave blank to keep the saved key" />
                    <TextBlock x:Name="AiKeyStatusText" TextWrapping="Wrap" Opacity="0.65" />
                    <TextBox x:Name="AiModelBox" Header="Model" ToolTipService.ToolTip="Must support images and structured output." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save AI settings" Click="SaveAiSettingsButton_Click" />
                        <Button Content="Remove key" Click="RemoveAiKeyButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="AiSettingsStatusText" TextWrapping="Wrap" />
                    <TextBlock Text="Analysis sends the screenshot and OCR text to OpenAI. The key is stored in Windows Credential Locker."
                        TextWrapping="Wrap" Opacity="0.65" />
                    <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,8,0,4" />
                    <TextBlock Text="Usage and limits" FontWeight="SemiBold" />
                    <NumberBox x:Name="AiDailyLimitBox" Header="Daily API request limit" Minimum="0" Maximum="10000"
                        Value="100" SmallChange="1" SpinButtonPlacementMode="Compact"
                        ToolTipService.ToolTip="Includes AI analysis, indexing, search and failed requests. 0 blocks new requests. Resets at 00:00 UTC." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save limit" Click="SaveUsageLimit_Click" />
                        <Button Content="Refresh usage" Click="RefreshAiUsageButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UsageSettingsStatusText" TextWrapping="Wrap" />
                    <TextBlock x:Name="AiUsageText" TextWrapping="Wrap" />
                    <TextBlock Text="Resets at 00:00 UTC. Token totals include usage reported by the API; interrupted requests may still be charged."
                        TextWrapping="Wrap" Opacity="0.65" />
                </StackPanel>
            </Expander>
            <Expander Header="About" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBlock Text="Smart Screenshot Manager" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="AppVersionText" Opacity="0.65" TextWrapping="Wrap" />
                    <TextBlock Text="Capture, organize and find your screenshots with text recognition and AI-powered search."
                        TextWrapping="Wrap" />
                    <HyperlinkButton Content="View project on GitHub"
                        NavigateUri="https://github.com/Qui1d/SmartScreenshotManager" Padding="0" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
