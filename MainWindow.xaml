<Window
    x:Class="SmartScreenshotManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SmartScreenshotManager.Models"
    xmlns:views="using:SmartScreenshotManager.Views"
    Title="Smart Screenshot Manager">

    <Grid
        x:Name="MainGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AllowDrop="True"
        DragEnter="MainGrid_DragEnter"
        DragOver="MainGrid_DragOver"
        DragLeave="MainGrid_DragLeave"
        Drop="MainGrid_Drop">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Padding="20">

                    <TextBlock
                        Text="Smart Screenshot"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Margin="0,10,0,30" />

                    <Button
                        x:Name="AllScreenshotsButton"
                        Content="All Screenshots"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="AllScreenshotsButton_Click" />

                    <Button
                        x:Name="FavoritesButton"
                        Content="Favorites"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="FavoritesButton_Click" />

                    <Button
                        x:Name="GamingButton"
                        Content="Gaming"
                        Tag="Gaming"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="CategoryButton_Click" />

                    <Button
                        x:Name="ProgrammingButton"
                        Content="Programming"
                        Tag="Programming"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="CategoryButton_Click" />

                    <Button
                        x:Name="DocumentsButton"
                        Content="Documents"
                        Tag="Documents"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="CategoryButton_Click" />

                    <Button
                        x:Name="OtherButton"
                        Content="Other"
                        Tag="Other"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,8"
                        Click="CategoryButton_Click" />

                    <Button x:Name="ActivityButton" Content="Processing / Activity"
                        HorizontalAlignment="Stretch" Margin="0,16,0,8" Click="ActivityButton_Click" />
                </StackPanel>

                <Button
                    Grid.Row="1"
                    Content="Settings"
                    HorizontalAlignment="Stretch"
                    Margin="20"
                    Click="SettingsButton_Click" />

            </Grid>

        </Border>

        <!-- Gallery page -->
        <Grid
            x:Name="GalleryPage"
            Grid.Column="1"
            Padding="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    x:Name="GalleryTitle"
                    Text="All Screenshots"
                    FontSize="30"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />

                <Button
                    x:Name="SortButton"
                    Grid.Column="1"
                    Content="Newest first"
                    MinWidth="155"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">

                    <Button.Flyout>

                        <MenuFlyout
                            Placement="Bottom">

                            <MenuFlyoutItem
                                Text="Newest first"
                                Click="NewestFirstMenuItem_Click" />

                            <MenuFlyoutItem
                                Text="Oldest first"
                                Click="OldestFirstMenuItem_Click" />

                        </MenuFlyout>

                    </Button.Flyout>

                </Button>

                <Button
                   Grid.Column="2"
                   Content="+ New Snip"
                   VerticalAlignment="Center"
                   Padding="18,8"
                   Click="NewSnipButton_Click" />

            </Grid>

            <!-- Search within the active section; TextBox supplies its own clear button. -->
            <TextBox
                x:Name="SearchTextBox"
                Grid.Row="1"
                Margin="0,20,0,14"
                PlaceholderText="Search screenshots, text or tags..."
                AutomationProperties.Name="Search screenshots by filename, category, recognized text, description or tags"
                Height="42"
                TextChanged="SearchTextBox_TextChanged"
                KeyDown="SearchTextBox_KeyDown" />

            <!-- Current screenshot folder and persistent storage errors -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18" Spacing="8">
                <CheckBox x:Name="SemanticModeCheckBox" Content="Search by meaning"
                    Checked="SemanticMode_Changed" Unchecked="SemanticMode_Changed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SemanticSearchButton" Content="Search by meaning" IsEnabled="False"
                        Click="SemanticSearchButton_Click" />
                    <Button x:Name="IndexSemanticButton" Content="Update folder index (API)"
                        Click="IndexSemanticButton_Click" />
                    <Button x:Name="CancelSemanticButton" Content="Cancel" IsEnabled="False"
                        Click="CancelSemanticButton_Click" />
                </StackPanel>
                <TextBlock Text="Indexing sends OCR, descriptions and tags to OpenAI. Search sends your phrase. Both use your API balance and daily request limit. Unchanged indexed items are skipped."
                    TextWrapping="Wrap" Opacity="0.6" />
                <TextBlock x:Name="SemanticStatusText" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SelectedFolderText"
                    Text="No screenshot folder selected"
                    Opacity="0.55"
                    TextTrimming="CharacterEllipsis" />
                <InfoBar
                    x:Name="StorageInfoBar"
                    IsOpen="False"
                    Severity="Error"
                    Title="Screenshot library"
                    IsClosable="True" />
            </StackPanel>

            <!-- Gallery + Details -->
            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition
                        x:Name="GalleryColumn"
                        Width="*" />

                    <ColumnDefinition
                        x:Name="DetailsColumn"
                        Width="0" />

                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="EmptyGalleryText"
                    Grid.Column="0"
                    Text="No favorite screenshots yet."
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="20"
                    Opacity="0.6"
                    IsHitTestVisible="False" />

                <!-- Gallery -->
                <GridView
                    x:Name="ScreenshotGridView"
                    Grid.Column="0"
                    ItemsSource="{x:Bind VisibleScreenshots}"
                    SelectionMode="Single"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemsPanel>

                        <ItemsPanelTemplate>

                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                ItemWidth="250" />

                        </ItemsPanelTemplate>

                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:ScreenshotItem">

                            <Border
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Margin="6"
                                Padding="10"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                DoubleTapped="ScreenshotCard_DoubleTapped"
                                PointerEntered="ScreenshotCard_PointerEntered"
                                PointerExited="ScreenshotCard_PointerExited"
                                Unloaded="ScreenshotCard_Unloaded">

                                <!-- Right-click menu -->
                                <Border.ContextFlyout>

                                    <MenuFlyout>

                                        <MenuFlyoutItem
                                            Text="Open"
                                            Icon="OpenFile"
                                            Tag="{x:Bind FilePath}"
                                            Click="OpenScreenshotMenuItem_Click" />

                                        <MenuFlyoutItem
                                            Text="Details"
                                            Tag="{x:Bind FilePath}"
                                            Click="DetailsScreenshotMenuItem_Click">

                                            <MenuFlyoutItem.Icon>

                                                <FontIcon
                                                    Glyph="&#xE946;" />

                                            </MenuFlyoutItem.Icon>

                                        </MenuFlyoutItem>

                                        <MenuFlyoutItem
                                            Text="Copy"
                                            Icon="Copy"
                                            Tag="{x:Bind FilePath}"
                                            Click="CopyScreenshotMenuItem_Click" />

                                        <MenuFlyoutItem
                                            Text="{x:Bind FavoriteActionText, Mode=OneWay}"
                                            Tag="{x:Bind Id}"
                                            IsEnabled="{x:Bind CanChangeFavorite, Mode=OneWay}"
                                            Click="FavoriteMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSubItem
                                            Text="Set category"
                                            IsEnabled="{x:Bind CanChangeCategory, Mode=OneWay}">
                                            <MenuFlyoutItem
                                                Text="Gaming"
                                                Tag="{x:Bind Id}"
                                                Click="CategoryMenuItem_Click" />
                                            <MenuFlyoutItem
                                                Text="Programming"
                                                Tag="{x:Bind Id}"
                                                Click="CategoryMenuItem_Click" />
                                            <MenuFlyoutItem
                                                Text="Documents"
                                                Tag="{x:Bind Id}"
                                                Click="CategoryMenuItem_Click" />
                                            <MenuFlyoutItem
                                                Text="Other"
                                                Tag="{x:Bind Id}"
                                                Click="CategoryMenuItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="Clear category"
                                                Tag="{x:Bind Id}"
                                                Click="ClearCategoryMenuItem_Click" />
                                            <MenuFlyoutItem
                                                Text="Allow AI category updates"
                                                Tag="{x:Bind Id}"
                                                Click="AllowAiCategoryMenuItem_Click" />
                                        </MenuFlyoutSubItem>

                                        <MenuFlyoutSeparator />

                                        <MenuFlyoutItem
                                            Text="Delete"
                                            Icon="Delete"
                                            Tag="{x:Bind FilePath}"
                                            Click="DeleteScreenshotMenuItem_Click" />

                                    </MenuFlyout>

                                </Border.ContextFlyout>

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Image
                                        Grid.Row="0"
                                        Source="{x:Bind FilePath}"
                                        HorizontalAlignment="Stretch"
                                        Height="140"
                                        Stretch="UniformToFill" />

                                    <Button
                                        Grid.Row="0"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        Margin="6"
                                        CornerRadius="17"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Opacity="{x:Bind FavoriteButtonOpacity, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanChangeFavorite, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind FavoriteActionText, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind FavoriteActionText, Mode=OneWay}"
                                        Tag="{x:Bind Id}"
                                        Click="FavoriteButton_Click"
                                        DoubleTapped="FavoriteButton_DoubleTapped"
                                        GotFocus="FavoriteButton_GotFocus"
                                        LostFocus="FavoriteButton_LostFocus">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                            FontSize="18" />
                                    </Button>

                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind FileName}"
                                        Margin="0,6,0,0"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Text="{x:Bind CreatedAt}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        FontSize="12"
                                        Opacity="0.6" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </GridView.ItemTemplate>

                </GridView>

                <!-- Details panel -->
                <Border
                    x:Name="DetailsPanel"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="18"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Details header -->
                        <Grid>

                            <TextBlock
                                Text="Screenshot details"
                                FontSize="18"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />

                            <Button
                                HorizontalAlignment="Right"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Click="CloseDetailsButton_Click">

                                <FontIcon
                                    Glyph="&#xE711;"
                                    FontSize="12" />

                            </Button>

                        </Grid>

                        <!-- Details content -->
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,12,0,0">

                            <StackPanel Spacing="10">

                                <Image
                                    x:Name="DetailsImage"
                                    Width="340"
                                    Height="220"
                                    HorizontalAlignment="Center"
                                    Stretch="Uniform" />

                                <TextBlock
                                    x:Name="DetailsFileName"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    x:Name="DetailsDate"
                                    Opacity="0.65" />

                                <Border
                                    Height="1"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Margin="0,4,0,4" />

                                <TextBlock
                                    Text="Category"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    x:Name="DetailsCategory"
                                    Text="Not assigned"
                                    Opacity="0.7"
                                    TextWrapping="Wrap" />

                                <TextBlock x:Name="DetailsCategorySource" Opacity="0.6" TextWrapping="Wrap" />

                                <TextBlock
                                    Text="Description"
                                    FontWeight="SemiBold"
                                    Margin="0,6,0,0" />

                                <TextBlock
                                    x:Name="DetailsDescription"
                                    Text="No description yet"
                                    TextWrapping="Wrap"
                                    Opacity="0.7" />

                                <TextBlock Text="Tags" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailsTags" Text="No tags yet" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="AI analysis" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailsAiStatus" Text="NotProcessed" Opacity="0.7" />
                                <TextBlock x:Name="DetailsAiError" TextWrapping="Wrap" Visibility="Collapsed" />
                                <Button x:Name="AnalyzeAiButton" Content="Analyze with AI"
                                    HorizontalAlignment="Left" Click="AnalyzeAiButton_Click" />
                                <TextBlock x:Name="DetailsAiHint" TextWrapping="Wrap" Opacity="0.6" />

                                <TextBlock
                                    Text="OCR Text"
                                    FontWeight="SemiBold"
                                    Margin="0,6,0,0" />

                                <TextBlock
                                    x:Name="DetailsOcrStatus"
                                    Text="Status: Pending"
                                    Opacity="0.7" />

                                <TextBlock
                                    x:Name="DetailsOcrError"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    x:Name="DetailsOcrText"
                                    Text="Waiting for text recognition..."
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Opacity="0.7" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CopyOcrButton"
                                        Content="Copy text" IsEnabled="False"
                                        Click="CopyOcrButton_Click" />
                                    <Button x:Name="RetryOcrButton"
                                        Content="Run OCR again" IsEnabled="False"
                                        Click="RetryOcrButton_Click" />
                                </StackPanel>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <Grid x:Name="ActivityPage" Grid.Column="1" Padding="30" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Processing / Activity" FontSize="32" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock x:Name="ActivityFolderText" TextWrapping="Wrap" Opacity="0.6" />
                <TextBlock x:Name="ActivityQueueText" TextWrapping="Wrap" />
                <ProgressBar x:Name="ActivityProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="ActivitySummaryText" TextWrapping="Wrap" />
                <TextBlock x:Name="ActivitySemanticText" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="ActivityUsageText" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock Text="Shows the latest state of each screenshot. AI retries use your API balance and daily limit. Times are recorded from this update onward."
                    TextWrapping="Wrap" Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Refresh" Click="ActivityRefresh_Click" />
                    <CheckBox x:Name="ActivityFailuresOnly" Content="Failures / cancelled only"
                        Checked="ActivityFilter_Changed" Unchecked="ActivityFilter_Changed" />
                </StackPanel>
                <TextBlock x:Name="ActivityMessageText" TextWrapping="Wrap" />
                <TextBlock x:Name="ActivityCountText" Opacity="0.6" />
            </StackPanel>
            <ListView Grid.Row="3" x:Name="ActivityList" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityItem">
                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind FilePath}" />
                                <TextBlock Text="{x:Bind OcrLabel}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind AiLabel}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ErrorText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Retry OCR" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanRetryOcr}"
                                        Click="ActivityRetryOcr_Click" />
                                    <Button Content="Retry AI (API)" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanRetryAi}"
                                        Click="ActivityRetryAi_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Expander Grid.Row="4" Header="Recent processing log (UTC)" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ActivityLogText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>
            </Expander>
        </Grid>

        <!-- Settings page -->
        <Grid
            x:Name="SettingsPageContainer"
            Grid.Column="1"
            Padding="30"
            Visibility="Collapsed">

            <views:SettingsPage
                x:Name="SettingsView" />

        </Grid>

        <!-- Drag & drop overlay -->
        <Grid
            x:Name="DropOverlay"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#DD181818"
            Visibility="Collapsed"
            IsHitTestVisible="False">

            <Border
                Margin="40"
                CornerRadius="20"
                BorderBrush="#99FFFFFF"
                BorderThickness="2">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">

                    <FontIcon
                        Glyph="&#xE898;"
                        FontSize="64"
                        Foreground="White"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="Drag screenshots here"
                        Foreground="White"
                        FontSize="32"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>